[debug] [2026-08-10T15:41:13.565Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/testing-27a7a/rulesets {"name":"projects/testing-27a7a/rulesets/a912632d-3a53-4585-ade5-a3c1b901a411","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() { return request.auth != null; }\n    function isBos() {\n      return signedIn() && exists(/databases/$(database)/documents/bosAdmins/$(request.auth.uid));\n    }\n    function isAdmin() {\n      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&\n        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == \"admin\";\n    }\n    function isTeamAdmin(teamId) {\n      return signedIn() && get(/databases/$(database)/documents/teams/$(teamId)).data.admin.userId == request.auth.uid;\n    }\n    function isTeamMember(teamId) {\n      return signedIn() && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));\n    }\n    function isCurrentMember(teamId, memberId) {\n      return isTeamMember(teamId) && request.auth.uid == memberId;\n    }\n    function isTeamManager(teamId) {\n      return isTeamMember(teamId) &&\n        get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == \"manager\";\n    }\n    function canSelfPunch(teamId) {\n      return isTeamMember(teamId) && (\n        get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.attendanceMode == \"self\" ||\n        (!get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.keys().hasAny([\"attendanceMode\"]) &&\n          get(/databases/$(database)/documents/teams/$(teamId)).data.defaultAttendanceMode != \"managed\")\n      );\n    }\n\n    match /bosAdmins/{uid} {\n      allow read: if isBos();\n      allow write: if false;\n    }\n    match /users/{userId} {\n      allow get: if isBos() || (signedIn() && request.auth.uid == userId);\n      allow list: if isBos();\n      allow update: if signedIn() && request.auth.uid == userId &&\n        resource.data.role == \"admin\" && request.resource.data.role == resource.data.role;\n      allow create, delete: if false;\n    }\n    match /teams/{teamId} {\n      allow get: if isBos() || isTeamAdmin(teamId) || isTeamMember(teamId);\n      // Firestore will require admin queries to include admin.userId == uid.\n      allow list: if isBos() || (isAdmin() && resource.data.admin.userId == request.auth.uid);\n      allow create: if isBos() || (isAdmin() && request.resource.data.admin.userId == request.auth.uid);\n      allow update, delete: if isBos() || isTeamAdmin(teamId);\n\n      match /members/{memberId} {\n        allow read: if isBos() || isTeamAdmin(teamId) || isTeamManager(teamId) || (isTeamMember(teamId) && request.auth.uid == memberId);\n        allow create, delete: if isBos() || isTeamAdmin(teamId);\n        // A member may only update the aggregate shown on their own payment\n        // screen. Individual billing periods are restricted below.\n        allow update: if isBos() || isTeamAdmin(teamId) ||\n          (isCurrentMember(teamId, memberId) &&\n            request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n              \"billing\"\n            ])) ||\n          (isTeamManager(teamId) && request.auth.uid != memberId &&\n            request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n              \"firstName\", \"lastName\", \"contact\", \"customData\", \"attendanceMode\", \"updatedAt\"\n            ]));\n        match /{memberSubpath=**} {\n          allow read: if isBos() || isTeamAdmin(teamId) || (isTeamMember(teamId) && request.auth.uid == memberId);\n          // A checkout updates the selected period in the same Firestore\n          // transaction as the member summary and payment record.\n          allow update: if isBos() || isTeamAdmin(teamId) ||\n            (isCurrentMember(teamId, memberId) &&\n              request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n                \"paid\", \"balance\", \"status\", \"lastPaymentAmount\",\n                \"paymentMode\", \"lastPaymentDate\", \"updatedAt\"\n              ]));\n          allow create, delete: if isBos() || isTeamAdmin(teamId);\n        }\n      }\n      match /attendance/{dateId}/punches/{memberId} {\n        // Mobile attendance history reads the day's `punches` as a collection.\n        // Rules cannot prove a document-id filter for a collection query, so\n        // retain the prior team-member read access while keeping writes scoped.\n        allow read: if isBos() || isTeamAdmin(teamId) || isTeamMember(teamId);\n        allow create, update: if isBos() || isTeamAdmin(teamId) || isTeamManager(teamId) ||\n          (request.auth.uid == memberId && canSelfPunch(teamId) && request.resource.data.id == request.auth.uid);\n        allow delete: if isBos() || isTeamAdmin(teamId);\n      }\n      match /payments/{paymentId} {\n        allow read: if isBos() || isTeamAdmin(teamId) ||\n          (isTeamMember(teamId) && resource.data.memberId == request.auth.uid);\n        // Members can only write payment records that identify themselves.\n        // This covers the success/failure record created after Razorpay\n        // verification, while preventing cross-member writes.\n        allow create: if isBos() || isTeamAdmin(teamId) ||\n          (isTeamMember(teamId) && request.resource.data.memberId == request.auth.uid);\n        allow update: if isBos() || isTeamAdmin(teamId) ||\n          (isTeamMember(teamId) && resource.data.memberId == request.auth.uid &&\n            request.resource.data.memberId == request.auth.uid);\n        allow delete: if isBos() || isTeamAdmin(teamId);\n      }\n      match /salarySlips/{slipId} {\n        allow read: if isBos() || isTeamAdmin(teamId) ||\n          (isTeamMember(teamId) && resource.data.memberId == request.auth.uid);\n        allow write: if isBos() || isTeamAdmin(teamId);\n      }\n      match /leaveRequests/{requestId} {\n        allow read: if isBos() || isTeamAdmin(teamId) || isTeamManager(teamId) ||\n          (isTeamMember(teamId) && resource.data.memberId == request.auth.uid);\n        allow create: if isTeamMember(teamId) &&\n          request.resource.data.memberId == request.auth.uid &&\n          request.resource.data.status == \"pending\" &&\n          request.resource.data.leaveType == null &&\n          request.resource.data.reason is string &&\n          request.resource.data.reason.size() > 0 &&\n          get(/databases/$(database)/documents/teams/$(teamId)).data.billingConfig.billingType == \"salary\";\n        allow update: if isBos() || isTeamAdmin(teamId) ||\n          (isTeamManager(teamId) &&\n            resource.data.memberId != request.auth.uid &&\n            resource.data.status == \"pending\" &&\n            request.resource.data.status in [\"approved\", \"rejected\"] &&\n            request.resource.data.leaveType in [\"paid\", \"unpaid\", null] &&\n            request.resource.data.reviewedBy.id == request.auth.uid &&\n            request.resource.data.reviewedBy.role == \"manager\" &&\n            request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n              \"status\", \"leaveType\", \"reviewedBy\", \"reviewedAt\", \"updatedAt\"\n            ]));\n        allow delete: if isBos() || isTeamAdmin(teamId);\n      }\n      match /{teamSubpath=**} {\n        allow read, write: if isBos() || isTeamAdmin(teamId);\n      }\n    }\n    match /allMembers/{email} {\n      allow get: if isBos() || (signedIn() && resource.data.memberId == request.auth.uid);\n      // Admin collection queries must be restricted to mappings for their team.\n      allow list: if isBos() || (isAdmin() && isTeamAdmin(resource.data.teamId));\n      allow create: if isBos() || isTeamAdmin(request.resource.data.teamId);\n      allow update, delete: if isBos() || isTeamAdmin(resource.data.teamId);\n    }\n    match /customForms/{formId} {\n      // Members fetch known form IDs from their own team's `customForms`\n      // array. Listing every form remains restricted to administrators.\n      allow get: if isBos() || isAdmin() || signedIn();\n      allow list: if isBos() || isAdmin();\n      allow create: if isBos() || (isAdmin() && request.resource.data.adminUserId == request.auth.uid);\n      allow update, delete: if isBos() || (isAdmin() && resource.data.adminUserId == request.auth.uid);\n    }\n    match /pendingMembers/{userId} {\n      allow create, get, update, delete: if isBos() || (signedIn() && request.auth.uid == userId) || isAdmin();\n      allow list: if isBos() || isAdmin();\n    }\n    match /invites/{inviteId} {\n      allow read: if isBos() || signedIn();\n      allow create: if isBos() || isTeamAdmin(request.resource.data.teamId);\n      allow update, delete: if isBos() || isTeamAdmin(resource.data.teamId);\n    }\n    match /{document=**} {\n      allow read, write: if isBos();\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-08-10T15:41:13.028031Z","metadata":{"services":["cloud.firestore"]}}
